# AnyList Credentials
ANYLIST_USERNAME=your_email@example.com
# Preferred on macOS: save your password using `npm run keychain:set -- you@example.com`.
# ANYLIST_PASSWORD=your_password
ANYLIST_KEYCHAIN_SERVICE=anylist-mcp

# AnyList Configuration
# Optional: only required when using shopping-list tools.
ANYLIST_LIST_NAME=Shopping List
